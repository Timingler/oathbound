-- Wind-up, fire, recovery, GDD v2 section 4 ("Combat timeline").
return function(t)
	local Timeline = t.shared("Timeline")
	local action = { id = "backstab", windup = 0.30, recovery = 0.40 }

	t.test("fires when the wind-up ends, then recovers", function()
		local tl = Timeline.new()
		assert(tl:start(action, 0, 0), "should start")
		local fired = tl:step(0.25)
		t.equal(fired, nil, "fired too early")
		fired = tl:step(0.30)
		t.equal(fired, action, "should fire at 0.30")
		t.equal(tl.state, "recovery")
		tl:step(0.65)
		t.equal(tl.state, "recovery", "recovery ended too early")
		tl:step(0.70)
		t.equal(tl.state, "idle")
	end)

	t.test("only one action at a time", function()
		local tl = Timeline.new()
		tl:start(action, 0, 0)
		t.equal(tl:start(action, 0.1, 0), false)
		tl:step(0.30)
		t.equal(tl:start(action, 0.35, 0), false, "recovery must commit you")
	end)

	t.test("cancel works during wind-up only", function()
		local tl = Timeline.new()
		tl:start(action, 0, 0)
		t.equal(tl:cancel(), action)
		t.equal(tl.state, "idle")
		tl:start(action, 1, 0)
		tl:step(1.30)
		t.equal(tl:cancel(), nil, "cannot cancel recovery")
	end)

	t.test("Action Speed shortens wind-up and recovery", function()
		local tl = Timeline.new()
		tl:start(action, 0, 0.25)
		t.near(tl.fireAt, 0.24)
		tl:step(0.24)
		t.near(tl.recoveryEnd, 0.24 + 0.32)
	end)

	t.test("busyFor reports time left", function()
		local tl = Timeline.new()
		tl:start(action, 0, 0)
		t.near(tl:busyFor(0.1), 0.2)
		t.near(tl:busyFor(5), 0)
	end)
end
